# {{ ansible_managed }}
server:
  http_listen_port: 9080
  grpc_listen_port: 0
  log_level: info

positions:
  filename: /var/lib/promtail/positions.yaml

clients:
  - url: {{ promtail_loki_push_url }}
    # Лейблы, общие для всех записей с этой ВМ
    external_labels:
{% for name, value in promtail_labels.items() %}
      {{ name }}: {{ value }}
{% endfor %}

scrape_configs:
  # --- Nginx: JSON access-лог и error-лог сайта приложения ---
  - job_name: nginx
    static_configs:
      - targets: [localhost]
        labels:
          job: nginx
          log_type: access
          __path__: {{ promtail_nginx_access_log }}
      - targets: [localhost]
        labels:
          job: nginx
          log_type: error
          __path__: {{ promtail_nginx_error_log }}
    pipeline_stages:
      - match:
          selector: '{log_type="access"}'
          stages:
            # Поля JSON доступны в LogQL через | json; здесь берём время запроса и метод
            - json:
                expressions:
                  time: time
                  method: request_method
            - timestamp:
                source: time
                format: RFC3339
            - labels:
                method:
      - match:
          selector: '{log_type="error"}'
          stages:
            # Формат error_log в nginx не настраивается: 2026/10/27 12:00:00 [error] 123#123: ...
            - regex:
                expression: '^(?P<time>\d{4}/\d{2}/\d{2} \d{2}:\d{2}:\d{2}) \[(?P<level>\w+)\]'
            - timestamp:
                source: time
                format: "2006/01/02 15:04:05"
            - labels:
                level:

  # --- Контейнеры (stdout): приложение, PostgreSQL. Только помеченные logging=promtail ---
  - job_name: containers
    docker_sd_configs:
      - host: unix:///var/run/docker.sock
        refresh_interval: 15s
        filters:
          - name: label
            values: ["{{ promtail_docker_label_filter }}"]
    relabel_configs:
      - source_labels: [__meta_docker_container_name]
        regex: "/(.*)"
        target_label: container
      - source_labels: [__meta_docker_container_label_logging_job]
        target_label: job
      - source_labels: [__meta_docker_container_log_stream]
        target_label: stream
    pipeline_stages:
      - match:
          selector: '{job="{{ promtail_app_job }}"}'
          stages:
            # Приложение пишет JSON (logstash-logback-encoder): уровень — в лейбл, время — из события
            - json:
                expressions:
                  level: level
                  timestamp: '"@timestamp"'
            - labels:
                level:
            - timestamp:
                source: timestamp
                format: RFC3339Nano
