# {{ ansible_managed }}
# Переменные окружения приложения. Секреты подставляются из Ansible Vault.
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT={{ app_port }}
MANAGEMENT_SERVER_PORT={{ app_management_port }}
# Приложение стоит за nginx: схему и хост берёт из X-Forwarded-*
SERVER_FORWARDHEADERSSTRATEGY=framework
JAVA_OPTS={{ app_java_opts }}
LOG_DIR=/app/logs

SPRING_DATASOURCE_URL={{ app_db_url }}
SPRING_DATASOURCE_USERNAME={{ postgres_user }}
SPRING_DATASOURCE_PASSWORD={{ postgres_password }}

STORAGE_S3_BUCKET={{ app_s3_bucket }}
STORAGE_S3_REGION={{ app_s3_region }}
STORAGE_S3_ENDPOINT={{ app_s3_endpoint }}
STORAGE_S3_ACCESSKEY={{ app_s3_access_key }}
STORAGE_S3_SECRETKEY={{ app_s3_secret_key }}
STORAGE_S3_CDNURL={{ app_s3_cdn_url }}
