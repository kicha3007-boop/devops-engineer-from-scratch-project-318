          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Заполнение диска /, %",
      "description": "Корневая файловая система. Алерт «Заканчивается место на диске».",
      "datasource": {
        "type": "prometheus",
