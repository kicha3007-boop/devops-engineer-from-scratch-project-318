# {{ ansible_managed }}
# Переменные окружения Grafana. Секреты подставляются из Ansible Vault.
GF_SERVER_ROOT_URL={{ grafana_root_url }}
GF_SECURITY_ADMIN_USER={{ grafana_admin_user }}
GF_SECURITY_ADMIN_PASSWORD={{ grafana_admin_password }}
GF_USERS_ALLOW_SIGN_UP=false
GF_AUTH_ANONYMOUS_ENABLED=false
GF_ANALYTICS_REPORTING_ENABLED=false
GF_ANALYTICS_CHECK_FOR_UPDATES=false
GF_ANALYTICS_CHECK_FOR_PLUGIN_UPDATES=false
GF_NEWS_NEWS_FEED_ENABLED=false

# Почта для Grafana Alerting
GF_SMTP_ENABLED={{ (grafana_smtp_host | length > 0) | lower }}
GF_SMTP_HOST={{ grafana_smtp_host }}
GF_SMTP_USER={{ grafana_smtp_user }}
GF_SMTP_PASSWORD={{ grafana_smtp_password }}
GF_SMTP_FROM_ADDRESS={{ grafana_smtp_from }}
GF_SMTP_FROM_NAME={{ grafana_smtp_from_name }}
GF_SMTP_STARTTLS_POLICY={{ grafana_smtp_starttls_policy }}
GF_SMTP_SKIP_VERIFY={{ grafana_smtp_skip_verify | bool | lower }}
{% if grafana_rendering_server_url | length > 0 %}

# Рендеринг панелей в PNG (скриншоты дашбордов, картинки в письмах алертов)
GF_RENDERING_SERVER_URL={{ grafana_rendering_server_url }}
GF_RENDERING_CALLBACK_URL={{ grafana_rendering_callback_url }}
GF_RENDERING_RENDERER_TOKEN={{ grafana_rendering_token }}
{% endif %}
