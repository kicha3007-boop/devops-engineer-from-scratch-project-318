# {{ ansible_managed }}
# Loki одним процессом: индекс TSDB и чанки на файловой системе (том {{ loki_data_volume }})
auth_enabled: false

server:
  http_listen_port: 3100
  grpc_listen_port: 9096
  log_level: info
  # Ответ querier -> query-frontend идёт по gRPC; стектрейсы Java делают выборку ERROR-логов
  # больше лимита по умолчанию (4 МБ), и запрос зависает до таймаута
  grpc_server_max_recv_msg_size: {{ loki_grpc_max_msg_size }}
  grpc_server_max_send_msg_size: {{ loki_grpc_max_msg_size }}

frontend_worker:
  grpc_client_config:
    max_send_msg_size: {{ loki_grpc_max_msg_size }}
    max_recv_msg_size: {{ loki_grpc_max_msg_size }}

common:
  instance_addr: 127.0.0.1
  path_prefix: /loki
  storage:
    filesystem:
      chunks_directory: /loki/chunks
      rules_directory: /loki/rules
  replication_factor: 1
  ring:
    kvstore:
      store: inmemory

schema_config:
  configs:
    - from: "2024-01-01"
      store: tsdb
      object_store: filesystem
      schema: v13
      index:
        prefix: index_
        period: 24h

limits_config:
  retention_period: {{ loki_retention_period }}
  allow_structured_metadata: true
  volume_enabled: true

compactor:
  working_directory: /loki/compactor
  retention_enabled: true
  delete_request_store: filesystem

analytics:
  reporting_enabled: false
